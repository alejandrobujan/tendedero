/* Spanish. */

/* AppDelegate */
"Let Tendedero handle your screenshots?" = "¿Quieres que Tendedero se encargue de tus capturas?";
"Screenshots will hang on the line the instant you take them, without the floating thumbnail, and will not pile up on your Desktop. Drag one to a folder to keep it, or discard it with the cross. You can turn this off from the menu bar, and your settings come back when Tendedero quits." = "Las capturas se colgarán al instante, sin la miniatura flotante, y no se acumularán en el Escritorio. Arrastra una a una carpeta para guardarla, o descártala con la cruz. Puedes desactivarlo desde la barra de menús, y tus ajustes vuelven a ser los de antes al salir de Tendedero.";
"Turn on" = "Activar";
"Not now" = "Ahora no";
"Hide line" = "Ocultar tendedero";
"Show line" = "Mostrar tendedero";
"Take everything down" = "Descolgar todo";
"Handle screenshots" = "Encargarse de las capturas";
"Screenshots hang instantly and skip the Desktop" = "Las capturas se cuelgan al instante y no pasan por el Escritorio";
"Open screenshots folder" = "Abrir carpeta de capturas";
"Sounds" = "Sonidos";
"Open at login" = "Abrir al iniciar sesión";
"Quit Tendedero" = "Salir de Tendedero";
"Could not change the login setting" = "No se pudo cambiar el inicio de sesión";
"Move Tendedero to the Applications folder and try again." = "Mueve Tendedero a la carpeta Aplicaciones y vuelve a intentarlo.";
"Hang images you copy too?" = "¿Colgar también las imágenes que copias?";
"Images you copy, like a screenshot taken with Control held or Copy Image in a browser, will hang on the line as well. Tendedero only keeps images, never text, and skips anything a password manager marks as private. You can change this from the menu bar." = "Las imágenes que copias, como una captura hecha con Control o Copiar imagen en un navegador, también se colgarán. Tendedero solo guarda imágenes, nunca texto, y omite lo que un gestor de contraseñas marca como privado. Puedes cambiarlo desde la barra de menús.";
"Hang copied images" = "Colgar imágenes copiadas";
"Images you copy hang on the line too" = "Las imágenes que copias también se cuelgan";
"Hang copied text" = "Colgar texto copiado";
"Text you copy hangs as a note card" = "El texto que copias se cuelga como una nota";

